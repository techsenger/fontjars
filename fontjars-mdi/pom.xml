<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.techsenger.fontjars</groupId>
        <artifactId>fontjars</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <groupId>com.techsenger.fontjars</groupId>
    <artifactId>fontjars-mdi</artifactId>
    <packaging>jar</packaging>
    <name>FontJars - MDI</name>
    <description>Material Design Icons font packaged as a modular JAR</description>

    <build>
        <resources>
            <resource>
                <filtering>false</filtering>
                <directory>${project.build.directory}/generated-resources/fonts</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>io.github.download-maven-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>download-fonts</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://github.com/Templarian/MaterialDesign-Webfont/archive/refs/tags/v7.4.47.zip</url>
                            <sha256>132990a45bc0200403bbe2a570494c3ea6d3c45eda1951f91aeb13cd7d7745b7</sha256>
                            <unpack>true</unpack>
                            <includes>
                                <include>MaterialDesign-Webfont-7.4.47/fonts/materialdesignicons-webfont.ttf</include>
                                <include>MaterialDesign-Webfont-7.4.47/LICENSE</include>
                            </includes>
                            <fileMappers>
                                <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                            </fileMappers>
                            <outputDirectory>
                                ${project.build.directory}/generated-resources/fonts/com/techsenger/fontjars/mdi
                            </outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
